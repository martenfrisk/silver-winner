# Optional cross-device sync (see docs/supabase.md). Copy this file to .env
# and fill in real values from your Supabase project's Settings > API page.
#
# The app builds and runs exactly as it does without these — no account, no
# sync UI — so this file is not required for local dev, tests or CI.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
